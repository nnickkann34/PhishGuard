# PhishGuard backend configuration.
# Copy to .env to override. Every value below is already the secure default,
# so the app runs safely with no .env at all. All variables use the PG_ prefix.

# --- Web ---
# Comma-separated list of allowed front-end origins (CORS).
PG_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Request limits ---
PG_MAX_URL_LENGTH=2048
PG_MAX_BODY_BYTES=65536          # 64 KB
PG_MAX_BATCH_URLS=50

# --- Denial-of-service protection (InferenceGuard) ---
PG_DOS_PROTECTION=true
PG_INFERENCE_WORKERS=2
PG_INFERENCE_QUEUE=8
PG_INFERENCE_TIMEOUT_SECONDS=5.0

# --- Storage ---
# Default is a SQLite file under backend/data/. Any SQLAlchemy URL works.
# PG_DATABASE_URL=sqlite:///./data/phishguard.db
PG_HISTORY_PAGE_SIZE=100

# --- Demonstration toggles (MUST stay at these values in normal operation) ---
# These exist ONLY so the security scripts can show before/after behaviour.
PG_INSECURE_SQL_DEMO=false        # true = deliberately injectable history search
PG_NORMALISE_HOMOGLYPHS=true      # false = disable look-alike normalisation
